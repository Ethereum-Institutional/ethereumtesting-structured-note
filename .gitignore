# dependencies
node_modules/
# lib/ is NOT ignored: the Foundry dependencies there are git submodules, and ignoring
# the directory silently kept their gitlinks out of the tree -- so a fresh clone got an
# empty lib/ and could not compile.

# build output
out/
cache/
broadcast/

# local state — regenerated by ops/reset.sh
ops/addresses.json

# misc
.DS_Store
*.log
*.tsbuildinfo
__pycache__/
.vercel
.env*

# network keys and API tokens (ops/keys.env is the published local-node set, and is tracked)
ops/keys.*.env
# public-network identifiers (ADR 0029); only the template is committed
ops/networks/*.json
!ops/networks/*.example.json
ops/addresses.*.json
