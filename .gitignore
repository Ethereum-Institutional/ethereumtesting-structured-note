# dependencies
node_modules/
# lib/ is NOT ignored: the Foundry dependencies there are git submodules, and ignoring
# the directory silently kept their gitlinks out of the tree -- so a fresh clone got an
# empty lib/ and could not compile.

# build output
out/
cache/
broadcast/
trex/artifacts/
trex/cache/
dashboard/.next/
dashboard/node_modules/
trex/node_modules/

# local state — regenerated by ops/reset.sh
ops/addresses.json

# misc
.DS_Store
*.log
*.tsbuildinfo
dashboard/.vercel/
ops/fly/anvil-state.json
ops/anvil-state.json
dashboard/.data/
.vercel
.env*
