{
  "name": "poc-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/copy-content.mjs",
    "predev": "npm run content",
    "prebuild": "npm run content",
    "dev": "next dev -p 3020",
    "build": "next build",
    "start": "next start -p 3020",
    "typecheck": "tsc --noEmit",
    "test": "node --test lib/chain/chain.test.ts lib/pool/quote.test.ts lib/notes/calendar.test.ts lib/notes/termsheet.test.ts",
    "test:chain": "node --test lib/chain/deployment.test.ts",
    "test:admission": "node --conditions=react-server --test --test-concurrency=1 test/onboarding.integration.ts test/notes.integration.ts test/governance.integration.ts test/deposit.integration.ts test/deployment.integration.ts",
    "test:browser": "next build && playwright test",
    "test:local": "../ops/reset.sh && npm test && npm run test:admission && ../ops/reset.sh && npm run test:browser"
  },
  "dependencies": {
    "@noble/post-quantum": "0.4.1",
    "next": "^15.5.23",
    "postgres": "^3.4.5",
    "qrcode": "1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3"
  }
}
